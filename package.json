{
  "name": "@xilin3/dsh-prompt-persona",
  "version": "0.2.0",
  "description": "DSH 插件：在设置页可视化编辑系统提示词（deployment:persona-prefix），支持实时预览与保存。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts/link-deps.mjs",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-settings": ">=0.1.5-rc <2",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.5-rc <2",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.5-rc <2",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.5-rc <2",
    "@deepseek-ai/cordis": ">=4.0.0-rc <5",
    "@deepseek-ai/schemastery": "^3.18.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "scripts": {
    "link-deps": "node scripts/link-deps.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xilin3/dsh-prompt-persona.git"
  },
  "bugs": {
    "url": "https://github.com/xilin3/dsh-prompt-persona/issues"
  },
  "homepage": "https://github.com/xilin3/dsh-prompt-persona#readme"
}
